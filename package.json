{
  "name": "cron-lit-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "node scripts/save-auth.mjs",
    "auth:firefox": "node scripts/save-auth.mjs --browser firefox",
    "auth:edge": "node scripts/save-auth.mjs --browser edge",
    "secret": "node scripts/export-secret.mjs",
    "checkin": "node scripts/checkin.mjs",
    "checkin:all": "node scripts/checkin-all.mjs",
    "checkin:summarize": "node scripts/summarize-checkin-results.mjs",
    "browsers": "playwright install chromium firefox msedge",
    "browsers:chromium": "playwright install chromium",
    "browsers:firefox": "playwright install firefox",
    "browsers:edge": "playwright install msedge",
    "check": "node --check scripts/browser.mjs && node --check scripts/save-auth.mjs && node --check scripts/checkin.mjs && node --check scripts/checkin-all.mjs && node --check scripts/checkin-result.mjs && node --check scripts/summarize-checkin-results.mjs && node --check scripts/export-secret.mjs && node --check scripts/litmedia-checkin.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "playwright": "^1.61.1"
  }
}
