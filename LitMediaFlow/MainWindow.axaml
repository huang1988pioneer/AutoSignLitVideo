<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LitMediaFlow.MainWindow"
        Width="1220" Height="820" MinWidth="600" MinHeight="520"
        Title="LitMedia Flow — 自動簽到控制台" Icon="/Assets/app-icon.png"
        FontFamily="{StaticResource InterfaceFont}" FontSize="14"
        Background="{StaticResource CanvasBrush}">
  <Window.Styles>
    <StyleInclude Source="avares://LitMediaFlow/ConsoleStyles.axaml"/>
  </Window.Styles>

  <Grid ColumnDefinitions="Auto,*" Container.Name="shell" Container.Sizing="Width">
    <Border x:Name="Rail" Padding="12,22" Background="{StaticResource RailBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Image Width="40" Height="40" Source="/Assets/app-icon.png"/>
          <StackPanel Classes="expanded" VerticalAlignment="Center">
            <TextBlock Text="LitMedia Flow" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="自動簽到控制台" Classes="caption"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="5">
          <TextBlock Classes="expanded caption" Text="工作區" Margin="12,0,0,6"/>
          <Button x:Name="DashboardNavButton" Classes="nav nav-active" Click="DashboardNav_OnClick"
                  AutomationProperties.Name="簽到總覽" ToolTip.Tip="簽到總覽">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="M3,13H11V3H3V13M3,21H11V15H3V21M13,21H21V11H13V21M13,3V9H21V3H13Z"/>
              <TextBlock Classes="expanded" Text="簽到總覽" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="LoginNavButton" Classes="nav" Click="LoginNav_OnClick"
                  AutomationProperties.Name="建立登入狀態" ToolTip.Tip="建立登入狀態">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z"/>
              <TextBlock Classes="expanded" Text="建立登入狀態" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="AccountsNavButton" Classes="nav" Click="AccountsNav_OnClick"
                  AutomationProperties.Name="帳號設定" ToolTip.Tip="帳號設定">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
              <TextBlock Classes="expanded" Text="帳號設定" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="GuideNavButton" Classes="nav" Click="GuideNav_OnClick"
                  AutomationProperties.Name="GitHub 設定指引" ToolTip.Tip="GitHub 設定指引">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="M12,21.5C10.65,20.65 8.2,20 6.5,20C4.85,20 3.15,20.3 1.75,21.05C1.65,21.1 1.6,21.1 1.5,21.1C1.25,21.1 1,20.85 1,20.6V6C1.6,5.55 2.25,5.25 3,5C4.11,4.65 5.33,4.5 6.5,4.5C8.45,4.5 10.55,4.9 12,6C13.45,4.9 15.55,4.5 17.5,4.5C18.67,4.5 19.89,4.65 21,5C21.75,5.25 22.4,5.55 23,6V20.6C23,20.85 22.75,21.1 22.5,21.1C22.4,21.1 22.35,21.1 22.25,21.05C20.85,20.3 19.15,20 17.5,20C15.8,20 13.35,20.65 12,21.5Z"/>
              <TextBlock Classes="expanded" Text="GitHub 設定指引" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Classes="expanded" Margin="8,0" Spacing="6">
          <Border Height="1" Margin="0,0,0,10" Background="{StaticResource LineBrush}"/>
          <TextBlock Text="本機登入狀態" FontWeight="SemiBold"/>
          <TextBlock Classes="caption" Text="登入資料儲存在這台電腦。你可以選擇寫入 GitHub Secret。"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer x:Name="ContentScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Pages" MaxWidth="1080">
        <StackPanel x:Name="DashboardView" Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Classes="title" Text="簽到總覽"/>
              <TextBlock Classes="detail" Text="查看 GitHub Actions 的執行結果與各帳號的點數。"/>
            </StackPanel>
            <Button x:Name="RefreshDashboardButton" Grid.Column="1" VerticalAlignment="Center" Click="RefreshDashboardButton_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="M17.65,6.35A7.95,7.95 0 0,0 12,4A8,8 0 1,0 19.93,13H17.9A6,6 0 1,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4Z"/>
                <TextBlock Text="更新執行結果" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>

          <Border Classes="sheet" Background="{StaticResource TintBrush}" BorderBrush="{StaticResource PlotGridBrush}">
            <Grid ColumnDefinitions="4*,5*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
              <StackPanel x:Name="ScheduleActions" Spacing="7" VerticalAlignment="Center">
                <TextBlock Classes="heading" Text="簽到排程" FontSize="24"/>
                <TextBlock Classes="detail" Text="自 2026/11/30 00:00（台北時間）起暫停自動排程，仍可手動簽到。"/>
                <Button x:Name="RunCheckinButton" Classes="primary" HorizontalAlignment="Left" Margin="0,6,0,0" Click="RunCheckinButton_OnClick">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="13" Height="13" Data="M4 2L20 12L4 22Z"/>
                    <TextBlock Text="手動觸發每日簽到" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
              <Viewbox x:Name="SchedulePlot" Stretch="Uniform" MaxHeight="130">
                <Canvas Width="414" Height="108" AutomationProperties.Name="截至 2026/11/29 的台北時段：05:00、13:00、21:00">
                  <Path Stroke="{StaticResource PlotGridBrush}" StrokeThickness="1"
                        Data="M14,34 H398 M14,55 H398 M14,76 H398 M14,29 V81 M46,29 V81 M78,29 V81 M110,29 V81 M142,29 V81 M174,29 V81 M206,29 V81 M238,29 V81 M270,29 V81 M302,29 V81 M334,29 V81 M366,29 V81 M398,29 V81"/>
                  <Path Fill="{StaticResource PlotFillBrush}" Data="M94,76 V39 H110 V76 Z M222,76 V39 H238 V76 Z M350,76 V39 H366 V76 Z"/>
                  <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                        Data="M14,76 H94 V39 H110 V76 H222 V39 H238 V76 H350 V39 H366 V76 H398"/>
                  <TextBlock Canvas.Left="68" Canvas.Top="4" Classes="time-label" Text="05:00"/>
                  <TextBlock Canvas.Left="196" Canvas.Top="4" Classes="time-label" Text="13:00"/>
                  <TextBlock Canvas.Left="324" Canvas.Top="4" Classes="time-label" Text="21:00"/>
                  <TextBlock Canvas.Left="14" Canvas.Top="83" Classes="data caption" Text="00:00"/>
                  <TextBlock Canvas.Left="358" Canvas.Top="83" Classes="data caption" Text="24:00"/>
                </Canvas>
              </Viewbox>
            </Grid>
          </Border>

          <Border Classes="sheet" Padding="0" ClipToBounds="True">
            <StackPanel>
              <UniformGrid x:Name="Metrics">
                <StackPanel Margin="18,14" Spacing="5">
                  <TextBlock x:Name="AccountCountLabel" Classes="caption" Text="已儲存登入"/>
                  <TextBlock x:Name="ConfiguredAccountsText" Classes="data value" Text="0 個"/>
                </StackPanel>
                <StackPanel Margin="18,14" Spacing="5">
                  <TextBlock Classes="caption" Text="回報連續天數的帳號"/>
                  <TextBlock x:Name="StreakTotalText" Classes="data value" Text="—"/>
                </StackPanel>
                <StackPanel Margin="18,14" Spacing="5">
                  <TextBlock Classes="caption" Text="帳號總點數"/>
                  <TextBlock x:Name="PointsTotalText" Classes="data value" Text="—"/>
                  <TextBlock x:Name="PointsCoverageText" Classes="caption" Text="尚無點數資料"/>
                </StackPanel>
                <StackPanel Margin="18,14" Spacing="5">
                  <TextBlock Classes="caption" Text="最近執行"/>
                  <TextBlock x:Name="CheckinStatusText" Classes="value" Text="尚未更新"/>
                </StackPanel>
              </UniformGrid>
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource RailBrush}" Padding="18,10">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Classes="caption" Text="上次成功"/>
                    <TextBlock x:Name="LastSuccessText" Classes="data" FontSize="13" TextWrapping="Wrap" Text="—"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Classes="caption" Text="上次失敗"/>
                    <TextBlock x:Name="LastFailureText" Classes="data" FontSize="13" TextWrapping="Wrap" Text="—"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Classes="caption" Text="連續成功天數"/>
                    <TextBlock x:Name="ConsecutiveSuccessDaysText" Classes="data" FontSize="13" TextWrapping="Wrap" Text="—"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <TextBlock x:Name="DashboardStatusText" Classes="detail" VerticalAlignment="Center" Text="正在讀取執行結果。"/>
            <Button x:Name="ViewRunButton" Grid.Column="1" IsVisible="False" Click="ViewRunButton_OnClick">查看執行紀錄</Button>
          </Grid>

          <Border Classes="sheet" Padding="0" ClipToBounds="True">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                <TextBlock x:Name="AccountsHeading" Classes="heading" Text="本機帳號狀態" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Click="LoginNav_OnClick">建立登入狀態</Button>
              </Grid>
              <Border x:Name="AccountTableHeader" Classes="row table-head"/>
              <ScrollViewer MaxHeight="312" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DashboardAccountsPanel"/>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0">
            <TextBlock Classes="caption" Text="程式碼行數"/>
            <TextBlock x:Name="CodeLineCountText" Classes="caption data" Text="—" ToolTip.Tip="啟動時計算來源檔的非空行"/>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="LoginView" IsVisible="False" Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="建立登入狀態"/>
            <TextBlock Classes="detail" Text="選擇帳號和瀏覽器，完成登入後將狀態存入 GitHub Secret。"/>
          </StackPanel>
          <Border Classes="sheet">
            <StackPanel Spacing="14">
              <TextBlock Classes="heading" Text="1. 選擇帳號與瀏覽器"/>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                <TextBlock Classes="caption" Text="帳號"/>
                <TextBlock Grid.Column="1" Classes="caption" Text="瀏覽器"/>
                <ComboBox x:Name="AccountComboBox" Grid.Row="1" HorizontalAlignment="Stretch" AutomationProperties.Name="帳號"/>
                <ComboBox x:Name="BrowserComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="瀏覽器"/>
                <TextBlock x:Name="AliasText" Grid.Row="2" Classes="detail"/>
                <TextBlock x:Name="BrowserHintText" Grid.Row="2" Grid.Column="1" Classes="detail"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="sheet">
            <StackPanel Spacing="12">
              <TextBlock Classes="heading" Text="2. 在瀏覽器登入"/>
              <TextBlock x:Name="LoginFlowHintText" Classes="detail"/>
              <WrapPanel>
                <Button x:Name="RunLoginButton" Classes="primary" Margin="0,0,8,0" Click="RunLoginButton_OnClick">開啟登入流程</Button>
                <Button x:Name="SaveLoginButton" Classes="primary" Margin="0,0,8,0" IsVisible="False" Click="SaveLoginButton_OnClick">儲存登入狀態</Button>
                <Button x:Name="CancelLoginButton" IsVisible="False" Click="CancelLoginButton_OnClick">取消登入</Button>
              </WrapPanel>
              <TextBlock x:Name="LoginStatusText" Classes="detail" AutomationProperties.LiveSetting="Polite"
                         IsVisible="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>
          <Border Classes="sheet">
            <StackPanel Spacing="12">
              <TextBlock Classes="heading" Text="3. 設定 GitHub Secret"/>
              <Border Background="{StaticResource TintBrush}" Padding="10,7" CornerRadius="5" HorizontalAlignment="Left">
                <TextBlock x:Name="SecretNameText" Classes="data" Foreground="{StaticResource AccentPressedBrush}" TextWrapping="Wrap"/>
              </Border>
              <TextBlock x:Name="StateDescription" Classes="detail"/>
              <WrapPanel>
                <Button x:Name="UploadSecretButton" Classes="primary" Margin="0,0,8,6" IsEnabled="False" Click="UploadSecretButton_OnClick">寫入 GitHub Secret</Button>
                <Button x:Name="OpenSecretsButton" Margin="0,0,8,6" Click="OpenSecretsButton_OnClick">開啟 Secrets 頁面</Button>
                <Button x:Name="CopyStateButton" Margin="0,0,8,6" IsEnabled="False" Click="CopyStateButton_OnClick">複製 Base64</Button>
                <Button x:Name="CopySecretButton" Margin="0,0,0,6" Click="CopySecretButton_OnClick">複製 Secret 名稱</Button>
              </WrapPanel>
              <TextBlock Classes="detail" Text="直接寫入會使用這台電腦已登入的 GitHub CLI。如要手動新增，請複製 Base64 並貼到 Secrets 頁面。"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="StatusText" Classes="detail" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <StackPanel x:Name="AccountsView" IsVisible="False" Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="帳號設定"/>
            <TextBlock Classes="detail" Text="為帳號設定便於辨識的別名。變更只會儲存在這台電腦。"/>
          </StackPanel>
          <Border Classes="sheet">
            <StackPanel Spacing="14">
              <TextBlock Classes="heading" Text="帳號別名"/>
              <ScrollViewer MaxHeight="438" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AliasListPanel" Spacing="8"/>
              </ScrollViewer>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button x:Name="SaveAliasesButton" Classes="primary" Click="SaveAliasesButton_OnClick">儲存帳號設定</Button>
                <TextBlock x:Name="AliasStatusText" Grid.Column="1" Classes="detail" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="GuideView" IsVisible="False" Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="GitHub 設定指引"/>
            <TextBlock Classes="detail" Text="把本機登入狀態交給 GitHub Actions，用於每日排程。"/>
          </StackPanel>
          <Border Classes="sheet">
            <StackPanel Spacing="18">
              <TextBlock Classes="heading" Text="設定步驟"/>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="34" Height="32" CornerRadius="5" Background="{StaticResource TintBrush}" VerticalAlignment="Top">
                  <TextBlock Classes="data" Foreground="{StaticResource AccentBrush}" Text="01" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="儲存登入狀態" FontWeight="SemiBold"/>
                  <TextBlock Classes="detail" Text="在「建立登入狀態」選擇帳號與瀏覽器，登入後回到 App，按「儲存登入狀態」。"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="34" Height="32" CornerRadius="5" Background="{StaticResource TintBrush}" VerticalAlignment="Top">
                  <TextBlock Classes="data" Foreground="{StaticResource AccentBrush}" Text="02" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="新增 Actions Secret" FontWeight="SemiBold"/>
                  <TextBlock Classes="detail" Text="按「寫入 GitHub Secret」，或複製 Base64 到 Secrets 頁面手動新增。"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="34" Height="32" CornerRadius="5" Background="{StaticResource TintBrush}" VerticalAlignment="Top">
                  <TextBlock Classes="data" Foreground="{StaticResource AccentBrush}" Text="03" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="核對 Secret 名稱" FontWeight="SemiBold"/>
                  <TextBlock Classes="detail" Text="以 LITMEDIA_STORAGE_STATE_BASE64_N 命名，將 N 換成帳號編號。"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="34" Height="32" CornerRadius="5" Background="{StaticResource TintBrush}" VerticalAlignment="Top">
                  <TextBlock Classes="data" Foreground="{StaticResource AccentBrush}" Text="04" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="查看簽到結果" FontWeight="SemiBold"/>
                  <TextBlock Classes="detail" Text="手動觸發每日簽到後，前往 GitHub Actions 查看該次執行紀錄。"/>
                </StackPanel>
              </Grid>
              <WrapPanel>
                <Button Classes="primary" Margin="0,0,8,4" Click="OpenActionsButton_OnClick">開啟 GitHub Actions</Button>
                <Button Margin="0,0,0,4" Click="OpenSecretsButton_OnClick">開啟 Secrets 頁面</Button>
              </WrapPanel>
              <TextBlock x:Name="GuideStatusText" Classes="detail" AutomationProperties.LiveSetting="Polite"
                         IsVisible="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>
          <Border Classes="sheet" Background="{StaticResource WarningSurfaceBrush}" Padding="16,12">
            <TextBlock Classes="detail" Foreground="{StaticResource WarningBrush}" Text="若 LitMedia 要求 OTP 或 CAPTCHA，請自行在瀏覽器完成驗證，再重新儲存登入狀態。"/>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
